    <dashboard enable-sort-zone-taborder='true' name='Dashboard 2 - Volatility Stress &amp; Risk Sensitivity'>
      <style />
      <size maxheight='1050' maxwidth='1440' minheight='1050' minwidth='1440' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98476' id='13' param='vert' type-v2='layout-flow' w='98888' x='556' y='762'>
